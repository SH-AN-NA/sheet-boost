{
  "manifest_version": 3,
  "name": "Sheet Boost for takeUforward",
  "version": "1.0.9",
  "description": "Add direct platform links and clearer progress styling to takeUforward sheets.",
  "icons": {
    "16": "icons/sheet-boost-16.png",
    "32": "icons/sheet-boost-32.png",
    "48": "icons/sheet-boost-48.png",
    "128": "icons/sheet-boost-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://takeuforward.org/*", "https://www.takeuforward.org/*"],
  "action": {
    "default_title": "Sheet Boost",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/sheet-boost-16.png",
      "32": "icons/sheet-boost-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://takeuforward.org/*", "https://www.takeuforward.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["questions-map.json", "current-a2z-data.json", "icons/gfg.png", "icons/leetcode.png", "icons/cn.png"],
      "matches": ["https://takeuforward.org/*", "https://www.takeuforward.org/*"]
    }
  ]
}
